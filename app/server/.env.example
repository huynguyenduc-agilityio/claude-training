# Copy to .env and adjust. All values are optional; defaults are shown.
API_PORT=4000
DB_PATH=data/usage.db
# IANA time zone used to decide which month a usage record belongs to
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Monthly budget in USD; warning at 80%, exceeded at 100%
MONTHLY_BUDGET_USD=30
# Optional webhook that receives a JSON POST when spending reaches 80% of the budget and again at 100%
# BUDGET_ALERT_WEBHOOK_URL=https://example.com/hook
